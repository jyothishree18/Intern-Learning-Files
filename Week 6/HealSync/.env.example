
# PostgreSQL Database
POSTGRES_DB=healsync
POSTGRES_USER=healsync_user
POSTGRES_PASSWORD=change_me

# Keycloak Database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=change_me

# Keycloak Admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_REALM=healsync
KEYCLOAK_ADMIN_REALM=master

# Keycloak Backend Service Account
KEYCLOAK_SERVICE_CLIENT_ID=healsync-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=your_service_account_secret

# MinIO Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET_NAME=healsync-reports
S3_REGION=us-east-1
